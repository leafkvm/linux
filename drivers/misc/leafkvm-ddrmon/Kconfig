config LEAFKVM_DDRMON
	tristate "RV1126B DDR3 bandwidth telemetry for LeafKVM"
	depends on OF && COMMON_CLK
	depends on ARCH_ROCKCHIP || COMPILE_TEST
	select MFD_SYSCON
	help
	  Read-only character device /dev/leafkvm-ddrmon reporting DDR3 payload
	  bandwidth from the RV1126B DDRMON block, independent of DMC/devfreq.
	  Requires the DFI and DMC device tree nodes to stay disabled.  See
	  drivers/misc/leafkvm-ddrmon/ABI.txt.

	  To compile this driver as a module, choose M here: the module
	  will be called leafkvm-ddrmon.
